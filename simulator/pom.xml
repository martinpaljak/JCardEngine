<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>pro.javacard</groupId>
        <artifactId>jcardengine-package</artifactId>
        <version>26.09.02-SNAPSHOT</version>
    </parent>
    <artifactId>jcardengine</artifactId>
    <name>JCardEngine - JavaCard Simulator</name>

    <properties>
        <!-- The API versions the engine implements -->
        <globalplatform.version>1.8</globalplatform.version>
        <globalplatform.contactless.version>1.4</globalplatform.contactless.version>
        <globalplatform.broker.version>1.1</globalplatform.broker.version>
        <!-- The API versions the test applet CAPs link against -->
        <globalplatform.import.version>1.6</globalplatform.import.version>
        <globalplatform.contactless.import.version>1.2</globalplatform.contactless.import.version>
        <coverage.dir>${project.basedir}/../coverage</coverage.dir>
        <caps.skip>false</caps.skip>
        <jacoco.skip>false</jacoco.skip>
        <!-- Overwritten by the JaCoCo agent. The placeholder gives the forked API rewrite
             and the test JVMs a valid argument when coverage is off. -->
        <argLine>-Dfile.encoding=UTF-8</argLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>vnd.oracle</groupId>
            <artifactId>javacard-sdk</artifactId>
            <version>${javacard.sdk.version}</version>
            <classifier>api-classic-${javacard.version}</classifier>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>vnd.globalplatform</groupId>
            <artifactId>api</artifactId>
            <version>${globalplatform.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>vnd.globalplatform</groupId>
            <artifactId>contactless</artifactId>
            <version>${globalplatform.contactless.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>vnd.globalplatform</groupId>
            <artifactId>broker</artifactId>
            <version>${globalplatform.broker.version}</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>
        <!-- Mandatory deps -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.19</version>
        </dependency>
        <!-- Instance proxy for Applets -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.18.13</version>
        </dependency>
        <!-- ASM for bytecode processing -->
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <version>9.10.1</version>
        </dependency>
        <!-- Global Platform support -->
        <dependency>
            <groupId>pro.javacard</groupId>
            <artifactId>globalplatformpro</artifactId>
            <version>${gppro.version}</version>
        </dependency>
        <!-- apdu4j: explicit core to override transitive version from globalplatformpro -->
        <dependency>
            <groupId>pro.javacard</groupId>
            <artifactId>apdu4j-core</artifactId>
            <version>${apdu4j.version}</version>
        </dependency>
        <!-- apdu4j pcsc-sim (transitively brings apdu4j-prefs) -->
        <dependency>
            <groupId>pro.javacard</groupId>
            <artifactId>apdu4j-pcsc-sim</artifactId>
            <version>${apdu4j.version}</version>
        </dependency>
        <dependency>
            <groupId>pro.javacard</groupId>
            <artifactId>apdu4j-prefs</artifactId>
            <version>${apdu4j.version}</version>
        </dependency>
        <!-- Faulty config parser -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>2.22.2</version>
        </dependency>
        <!-- unit tests -->
        <!-- CardBIBO: wraps a PC/SC Card as a BIBO for CryptoParityTest's reader backend -->
        <dependency>
            <groupId>pro.javacard</groupId>
            <artifactId>apdu4j-pcsc</artifactId>
            <version>${apdu4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>7.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.19</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Everything the vendor repository serves: unpacked before the API rewrite, copied before the CAP build -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-vendor</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <!-- JavaCardApiProcessor rewrites the API classes in place, so every run starts from pristine ones -->
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <outputDirectory>${project.build.directory}/classes</outputDirectory>
                            <includes>**/*.class,**/*.exp</includes>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>vnd.oracle</groupId>
                                    <artifactId>javacard-sdk</artifactId>
                                    <version>${javacard.sdk.version}</version>
                                    <classifier>api-classic-${javacard.version}</classifier>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>api</artifactId>
                                    <version>${globalplatform.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>contactless</artifactId>
                                    <version>${globalplatform.contactless.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>broker</artifactId>
                                    <version>${globalplatform.broker.version}</version>
                                </artifactItem>
                                <!-- The whole kit, for the converter -->
                                <artifactItem>
                                    <groupId>vnd.oracle</groupId>
                                    <artifactId>javacard-sdk</artifactId>
                                    <version>${javacard.sdk.version}</version>
                                    <type>zip</type>
                                    <includes>**</includes>
                                    <outputDirectory>${project.build.directory}/sdk</outputDirectory>
                                </artifactItem>
                                <!-- Export files of the API versions the test applet CAPs link against -->
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>api</artifactId>
                                    <version>${globalplatform.import.version}</version>
                                    <classifier>export-2.3</classifier>
                                    <outputDirectory>${project.build.directory}/exports</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>contactless</artifactId>
                                    <version>${globalplatform.contactless.import.version}</version>
                                    <classifier>export-2.3</classifier>
                                    <outputDirectory>${project.build.directory}/exports</outputDirectory>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>broker</artifactId>
                                    <version>${globalplatform.broker.version}</version>
                                    <classifier>export-2.3</classifier>
                                    <outputDirectory>${project.build.directory}/exports</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <!-- Classes the test applets compile against, older than the engine so a CAP loads on an older card -->
                    <execution>
                        <id>applet-imports</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/imports</outputDirectory>
                            <stripVersion>true</stripVersion>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>api</artifactId>
                                    <version>${globalplatform.import.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>contactless</artifactId>
                                    <version>${globalplatform.contactless.import.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>vnd.globalplatform</groupId>
                                    <artifactId>broker</artifactId>
                                    <version>${globalplatform.broker.version}</version>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <!-- The converter, taskdef'd off maven.plugin.classpath in build.xml -->
                <dependencies>
                    <dependency>
                        <groupId>pro.javacard</groupId>
                        <artifactId>ant-javacard</artifactId>
                        <version>${antjavacard.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <!-- Build the test applet CAPs -->
                    <execution>
                        <id>build-caps</id>
                        <phase>package</phase>
                        <configuration>
                            <skip>${caps.skip}</skip>
                            <target>
                                <ant antfile="build.xml" inheritAll="false" inheritRefs="true"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Run the ASM based proxy code injector -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>inject-implementation</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <!-- ${argLine} carries the JaCoCo agent (prepare-agent runs at process-resources, before this
                                     process-classes phase), so the forked API rewrite is instrumented and its data appends to the shared jacoco.exec. -->
                                <argument>${argLine}</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.licel.jcardsim.utils.JavaCardApiProcessor</argument>
                                <argument>${project.build.directory}/classes</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>trace-test-applets</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${argLine}</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>pro.javacard.engine.CommentTrace</argument>
                                <argument>${project.build.testOutputDirectory}</argument>
                                <argument>${project.build.testOutputDirectory}</argument>
                                <argument>${project.basedir}/src/test/java</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <includePluginDependencies>true</includePluginDependencies>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <links>
                        <link>https://docs.oracle.com/javase/8/docs/api/</link>
                        <link>https://docs.oracle.com/javase/8/docs/jre/api/security/smartcardio/spec/</link>
                    </links>
                    <author>false</author>
                    <source>8</source>
                </configuration>
            </plugin>
            <!-- Source jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>install</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>simulator-coverage</id>
            <activation>
                <property>
                    <name>!applet.coverage</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>agent</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <includes>
                                        <include>com/licel/jcardsim/**</include>
                                        <include>pro/javacard/engine/**</include>
                                        <include>javacard/**</include>
                                        <include>javacardx/**</include>
                                        <include>org/globalplatform/**</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <dependencies>
                            <dependency>
                                <groupId>org.jacoco</groupId>
                                <artifactId>org.jacoco.ant</artifactId>
                                <version>0.8.15</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>host-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <skip>${jacoco.skip}</skip>
                                    <target>
                                        <typedef resource="org/jacoco/ant/antlib.xml"/>
                                        <!-- Clean the previous report so removed classes leave no stale pages behind. -->
                                        <delete dir="${coverage.dir}/host"/>
                                        <report>
                                            <executiondata>
                                                <fileset dir="${project.build.directory}" includes="jacoco.exec"/>
                                            </executiondata>
                                            <structure name="${project.name}">
                                                <classfiles>
                                                    <!-- Host report = the engine plus the rewritten API proxies. Dropped:
                                                         applet code, the java.* and unimplemented JavaCard API packages,
                                                         and the no-proxy API stub classes (no host code, no debug info). -->
                                                    <fileset dir="${project.build.directory}/classes">
                                                        <exclude name="java/**"/>
                                                        <exclude name="com/licel/jcardsim/samples/**"/>
                                                        <exclude name="pro/javacard/engine/testapplets/**"/>
                                                        <exclude name="javacard/framework/service/**"/>
                                                        <exclude name="javacardx/biometry/**"/>
                                                        <exclude name="javacardx/biometry1toN/**"/>
                                                        <exclude name="javacardx/external/**"/>
                                                        <exclude name="javacardx/apdu/util/**"/>
                                                        <exclude name="javacardx/framework/util/**"/>
                                                        <exclude name="javacardx/framework/math/**"/>
                                                        <exclude name="javacardx/framework/string/**"/>
                                                        <exclude name="javacardx/framework/tlv/**"/>
                                                        <exclude name="javacard/framework/APDUComm.class"/>
                                                        <exclude name="javacard/framework/APDUException.class"/>
                                                        <exclude name="javacard/framework/ISOException.class"/>
                                                        <exclude name="javacard/framework/PINException.class"/>
                                                        <exclude name="javacard/framework/SystemException.class"/>
                                                        <exclude name="javacard/framework/TransactionException.class"/>
                                                        <exclude name="javacard/framework/UserException.class"/>
                                                        <exclude name="javacard/framework/OwnerPINBuilder.class"/>
                                                        <exclude name="javacard/security/CryptoException.class"/>
                                                        <exclude name="javacard/security/InitializedMessageDigest*.class"/>
                                                        <exclude name="javacardx/crypto/AEADCipher.class"/>
                                                    </fileset>
                                                </classfiles>
                                                <sourcefiles>
                                                    <fileset dir="${basedir}/src/main/java"/>
                                                    <!-- Rewritten API classes name the target source file; show the proxy sources under those names. -->
                                                    <mappedresources>
                                                        <fileset dir="${basedir}/src/main/java/pro/javacard/engine/proxy"/>
                                                        <globmapper from="*Proxy.java" to="*.java"/>
                                                    </mappedresources>
                                                </sourcefiles>
                                            </structure>
                                            <html destdir="${coverage.dir}/host"/>
                                            <xml destfile="${coverage.dir}/host/jacoco.xml"/>
                                        </report>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>applet-coverage</id>
            <activation>
                <property>
                    <name>applet.coverage</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>agent</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                                <configuration>
                                    <classDumpDir>${project.build.directory}/jacoco-dump</classDumpDir>
                                    <exclClassLoaders>*AppClassLoader:*PlatformClassLoader</exclClassLoaders>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <dependencies>
                            <dependency>
                                <groupId>org.jacoco</groupId>
                                <artifactId>org.jacoco.ant</artifactId>
                                <version>0.8.15</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <id>applet-coverage-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <skip>${jacoco.skip}</skip>
                                    <target>
                                        <typedef resource="org/jacoco/ant/antlib.xml"/>
                                        <!-- Clean the previous report so removed classes leave no stale pages behind. -->
                                        <delete dir="${coverage.dir}/applets"/>
                                        <report>
                                            <executiondata>
                                                <fileset dir="${project.build.directory}" includes="jacoco*.exec"/>
                                            </executiondata>
                                            <structure name="${project.name} (test applets)">
                                                <group name="test applets">
                                                    <classfiles>
                                                        <fileset dir="${project.build.directory}/jacoco-dump">
                                                            <include name="com/licel/jcardsim/samples/**"/>
                                                            <include name="pro/javacard/engine/testapplets/**"/>
                                                        </fileset>
                                                    </classfiles>
                                                    <sourcefiles>
                                                        <fileset dir="${basedir}/src/test/java"/>
                                                    </sourcefiles>
                                                </group>
                                            </structure>
                                            <html destdir="${coverage.dir}/applets"/>
                                            <xml destfile="${coverage.dir}/applets/jacoco.xml"/>
                                        </report>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
